{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["PORT", "BASE_WEB_URL", "GMAIL_USER", "GMAIL_APP_PASSWORD"],
  "tasks": {
    "format:check": {},
    "lint": {},
    "check-types": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "@devflow/db#build": { "outputs": ["src/generated/**"] },
    "@devflow/db#check-types": { "dependsOn": ["build"] },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
