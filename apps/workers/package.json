    "@devflow/storage": "workspace:*",
    "bullmq": "^5.76.8",
    "dotenv": "^17.4.2",
    "nodemailer": "^8.0.9",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@devflow/config": "workspace:*",
    "@types/node": "^25.7.0",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
