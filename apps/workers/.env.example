NODE_ENV=development
# Used to check the links in emails. The worker stops at startup without it.
BASE_WEB_URL=http://localhost:3000
# optional, defaults to the DevFlow logo
EMAIL_LOGO_URL=

DATABASE_URL=

REDIS_QUEUE_URL=redis://localhost:6381
REDIS_PUBSUB_URL=redis://localhost:6382

# Email (Gmail app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Files are deleted from storage by the cleanup worker
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_PRIVATE=
STORAGE_BUCKET_PUBLIC=
STORAGE_PUBLIC_URL=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=false

# Only if backend-common needs it at import (see the check above)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=