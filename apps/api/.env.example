PORT=4000
NODE_ENV=development
# Used for CORS and for links in notifications
BASE_WEB_URL=http://localhost:3000

# Pooled connection (runtime)
DATABASE_URL=

# Firebase Admin (checks the sign-in token). Keep the key on one line with \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Three Redis instances
REDIS_CACHE_URL=redis://localhost:6380
REDIS_QUEUE_URL=redis://localhost:6381
REDIS_PUBSUB_URL=redis://localhost:6382

# S3-compatible object storage (Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_PRIVATE=
STORAGE_BUCKET_PUBLIC=
STORAGE_PUBLIC_URL=
# optional, these are the defaults
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=false