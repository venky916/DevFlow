{
  "name": "ws-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit"
  },
  "prettier": "@devflow/config/prettier.js",
  "dependencies": {
    "@devflow/backend-common": "workspace:*",
    "@devflow/db": "workspace:*",
    "@devflow/types": "workspace:*",
    "@devflow/validators": "workspace:*",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@devflow/config": "workspace:*",
    "@types/node": "^25.6.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  }
}
