{
  "name": "devflow",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "check": "turbo run format:check lint check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "prettier": "^3.7.4",
    "turbo": "^2.9.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  }
}
